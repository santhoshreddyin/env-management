DATABASE_URL=sqlite:///./env_management.db
# DATABASE_URL=postgresql+psycopg://envmgmt:envmgmt@localhost:5432/envmgmt
CORS_ORIGINS=["http://localhost:5173"]
RUN_MIGRATIONS=true

# Auth: "dev" (no login, local only) or "header" (SSO via gateway / auth proxy)
AUTH_MODE=dev
DEV_USER=dev-user
DEV_ROLES=["viewer","maintainer"]
AUTH_USER_HEADER=X-Forwarded-User
AUTH_GROUPS_HEADER=X-Forwarded-Groups
MAINTAINER_GROUPS=["integration-maintainers"]
VIEWER_GROUPS=[]

# Optional override of protocol colours / layer ordering
# FLOW_CONFIG_PATH=/etc/env-management/flow_config.json
