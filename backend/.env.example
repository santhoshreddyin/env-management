DATABASE_URL=sqlite:///./env_management.db
# DATABASE_URL=postgresql+psycopg://envmgmt:envmgmt@localhost:5432/envmgmt
# Supabase (postgres:// and postgresql:// are normalised to postgresql+psycopg://):
# DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?sslmode=require
APP_ENV=local
CORS_ORIGINS=["http://localhost:5173"]
# CORS_ORIGIN_REGEX=^https://[a-z0-9-]+\.env-management\.pages\.dev$
RUN_MIGRATIONS=true

# Auth: "dev" (no login, local only) or "header" (SSO via gateway / auth proxy)
AUTH_MODE=dev
DEV_USER=dev-user
DEV_ROLES=["viewer","maintainer"]
AUTH_USER_HEADER=X-Forwarded-User
AUTH_GROUPS_HEADER=X-Forwarded-Groups
MAINTAINER_GROUPS=["integration-maintainers"]
VIEWER_GROUPS=[]
ADMIN_GROUPS=[]
ENV_MANAGER_GROUPS=[]
CONTRIBUTOR_GROUPS=[]
BOOKER_GROUPS=[]
# Users see only environments in their scoped role grants (admins see all)
PORTFOLIO_SEGREGATION=false

# Background jobs (booking release, alerts, health checks) and outbound webhooks
SCHEDULER_ENABLED=true
SCHEDULER_INTERVAL_SECONDS=300
WEBHOOKS_ENABLED=true
HEALTH_CHECK_TIMEOUT_SECONDS=5
STALE_AFTER_DAYS=90
# Optional e-mail notifications
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=env-management@example.com

# Optional override of protocol colours / layer ordering
# FLOW_CONFIG_PATH=/etc/env-management/flow_config.json
